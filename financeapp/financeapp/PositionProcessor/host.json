{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "FinanceHub",
      "storageProvider": {
        "maxQueuePollingInterval": "00:00:02"
      }
    }
  },
  "functionTimeout": "00:10:00"
}
